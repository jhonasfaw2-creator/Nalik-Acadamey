# ── Nalik Academy — Production Environment ─────
# Copy this to your VPS as .env and fill in real values.

# Database (SQLite — file path relative to project root)
DATABASE_URL="file:./prod.db"

# Admin credentials (CHANGE THESE)
ADMIN_EMAIL="admin@nalikacademy.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"

# Email (Resend — sign up at resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Nalik Academy <norely@nalikacademy.com>"

# Contact form recipient (falls back to ADMIN_EMAIL)
CONTACT_FORM_RECIPIENT=""

# WhatsApp admin notifications (optional)
ADMIN_WHATSAPP_NUMBER="+251911234567"

# Node environment
NODE_ENV="production"
