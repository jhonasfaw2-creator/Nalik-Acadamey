# Use CHAPA_TEST_... for sandbox and CHAPA_LIVE_... for real payments. The key
# prefix selects the environment the app enforces for webhook modes.
CHAPA_SECRET_KEY=CHAPA_TEST_replace_with_test_secret_key
CHAPA_WEBHOOK_SECRET=replace_with_the_webhook_secret_configured_in_chapa
NEXT_PUBLIC_APP_URL=https://your-deployment.example

# Configure these URLs in Chapa for the same environment as the secret key:
# Webhook: ${NEXT_PUBLIC_APP_URL}/api/payments/webhook
#          (or ${NEXT_PUBLIC_APP_URL}/api/webhooks/chapa)
# Return:  ${NEXT_PUBLIC_APP_URL}/checkout/return
# The server also sends the documented return_url field at initialization when
# NEXT_PUBLIC_APP_URL is an HTTPS origin.

# Vercel Blob (payment proof uploads). Set in your project's environment
# variables. Required when OIDC is enabled for the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_replace_with_your_token
