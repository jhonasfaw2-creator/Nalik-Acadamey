NEXT_PUBLIC_APP_URL=https://your-deployment.example
APP_URL=https://your-deployment.example

# Telegram payment-proof review notifications. After deploying, run
# `npm run telegram:webhook:set` to enable the Approve/Reject button callbacks.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_admin_chat_id
TELEGRAM_WEBHOOK_SECRET=replace_with_random_letters_numbers_underscores_or_hyphens

# Vercel Blob (payment proof uploads). Set in your project's environment
# variables. Required when OIDC is enabled for the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_replace_with_your_token
