# Chapa TEST-mode credentials only. Do not use live credentials until the
# hosted checkout, verification, and webhook flow has passed sandbox testing.
CHAPA_SECRET_KEY=CHAPA_TEST_replace_with_test_secret_key
CHAPA_WEBHOOK_SECRET=replace_with_the_webhook_secret_configured_in_chapa
NEXT_PUBLIC_APP_URL=https://your-test-preview.example

# Configure these URLs in Chapa for the Test environment where those
# destinations are supported:
# Webhook: ${NEXT_PUBLIC_APP_URL}/api/webhooks/chapa
# Return:  ${NEXT_PUBLIC_APP_URL}/checkout/return
# The API v2 reference does not document per-payment callback/return fields;
# this app deliberately does not send undocumented fields at initialization.
