// Nalik Academy - Prisma Schema
// Database: PostgreSQL (Neon)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Website Content (CMS key-value store, public read-only) ─
model Content {
  id        String   @id @default(cuid())
  section   String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
}

// ── Courses ───────────────────────────────────────────
model Course {
  id            String   @id @default(cuid())
  title         String
  description   String
  price         Int      @default(0)       // price in Birr
  discountPrice Int?                        // discounted price in Birr
  discountLabel String?                     // e.g. "Opening Offer — 19% off"
  active        Boolean  @default(true)     // shown in registration form
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  schedules    Schedule[]
  applications Application[]
}

// ── Schedules (class batches) ─────────────────────────
model Schedule {
  id          String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchName   String   // e.g. "Morning Batch A", "Weekend Batch"
  days        String   // e.g. "Mon, Wed, Fri" or "Sat, Sun"
  startTime   String   // e.g. "09:00"
  endTime     String   // e.g. "12:00"
  startDate   DateTime
  maxSeats    Int      @default(20)
  enrolled    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  applications Application[]
}// ── Registrations (student applications) ──────────────
// Registration lifecycle: PENDING_PAYMENT → PAID → CONFIRMED
model Application {
  id                 String   @id @default(cuid())
  referenceId        String   @unique // e.g. NA-2026-0001
  fullName           String
  email              String
  phone              String
  age                Int
  courseId            String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId          String?
  schedule            Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  previousExperience  String   @default("")
  motivation          String   @default("")
  status              String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, CONFIRMED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payment Payment?

  @@unique([email, courseId])
  @@index([status])
}

// ── Payments (Chapa) ───────────────────────────────────
// Payment lifecycle: PENDING → SUCCESS / FAILED / CANCELLED
// (also INCOMPLETE / BLOCKED / AUTH_NEEDED from Chapa)
model Payment {
  id                String    @id @default(cuid())
  applicationId     String    @unique
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount            Int       // amount in Birr, calculated server-side from the course
  currency          String    @default("ETB")
  merchantReference String?   @unique // Chapa merchant_reference (our unique tx_ref per attempt)
  chapaReference    String?   // Chapa payment reference (from checkout URL / webhook / verify)
  status            String    @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED, INCOMPLETE, BLOCKED, AUTH_NEEDED
  method            String?   // payment method reported by Chapa (telebirr, card, …)
  serviceFee        Int?      // Chapa service fee (Birr)
  rawWebhook        Json?     // last webhook payload, for audit
  notes             String?
  paidAt            DateTime? // set when payment reaches SUCCESS
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([chapaReference])
}

// ── Settings (key-value store) ────────────────────────
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
