// Nalik Academy - Prisma Schema
// Database: PostgreSQL (Neon)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Website Content (CMS key-value store, public read-only) ─
model Content {
  id        String   @id @default(cuid())
  section   String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
}

// ── Courses ───────────────────────────────────────────
model Course {
  id            String   @id @default(cuid())
  title         String
  description   String
  price         Int      @default(0)       // price in Birr
  discountPrice Int?                        // discounted price in Birr
  discountLabel String?                     // e.g. "Opening Offer, 19% off"
  active        Boolean  @default(true)     // shown in registration form
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  applications Application[]
}

// ── Schedules (shared schedule groups + sessions) ─────
// Two fixed schedule groups (A and B) each with three sessions (Morning,
// Afternoon, Evening). Sessions are shared across all courses: a student
// books a seat in one session of one group for their chosen course.
model Schedule {
  id          String   @id @default(cuid())
  group       String   // "A" or "B"
  days        String   // "Monday, Wednesday, Friday" or "Tuesday, Thursday, Saturday"
  session     String   // "Morning Session", "Afternoon Session", "Evening Session"
  startTime   String   // e.g. "08:00"
  endTime     String   // e.g. "10:00"
  maxSeats    Int      @default(15)
  enrolled    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([group, session])
  @@index([active])
  applications Application[]
}// ── Registrations (student applications) ──────────────
// Registration lifecycle: PENDING_PAYMENT → PAID → CONFIRMED
model Application {
  id                 String   @id @default(cuid())
  referenceId        String   @unique // e.g. NA-2026-0001
  fullName           String
  email              String
  phone              String
  age                Int
  courseId            String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId          String?
  schedule            Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  previousExperience  String   @default("")
  motivation          String   @default("")
  status              String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, CONFIRMED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payment Payment?

  @@unique([email, courseId])
  @@index([status])
}

// ── Payments (Chapa Inline.js) ─────────────────────────
// Payment lifecycle: PENDING → SUCCESS / FAILED / CANCELLED / INCOMPLETE
//
// The inline checkout runs in the browser against Chapa using a PUBLIC key;
// the amount there is client-supplied and therefore untrusted. The only
// source of truth is server-side verification (Chapa's verify endpoint) and
// signed webhooks, both of which check amount + currency against this row.
model Payment {
  id             String      @id @default(cuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount         Int         // amount in Birr, calculated server-side from the course
  currency       String      @default("ETB")
  txRef          String?     @unique // our unique tx_ref per attempt (Chapa "tx_ref")
  chapaReference String?     // Chapa's internal reference (verify/webhook "reference")
  status         String      @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED, INCOMPLETE
  method         String?     // payment method reported by Chapa (telebirr, cbebirr, …)
  charge         Int?        // Chapa transaction fee (Birr)
  rawWebhook     Json?       // last webhook payload, for audit
  notes          String?
  paidAt         DateTime?   // set when payment reaches SUCCESS
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([chapaReference])
}

// ── Settings (key-value store) ────────────────────────
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
