// Nalik Academy - Prisma Schema
// Database: PostgreSQL (Neon)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Website Content (CMS key-value store, public read-only) ─
model Content {
  id        String   @id @default(cuid())
  section   String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
}

// ── Courses ───────────────────────────────────────────
model Course {
  id              String        @id @default(cuid())
  title           String
  description     String
  price           Int           @default(0) // price in Birr
  discountPrice   Int?
  discountLabel   String?
  discountStartAt DateTime?
  discountEndAt   DateTime?
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  registrations   Registration[]
  materials       CourseMaterial[]

  @@index([active])
}

// ── Schedules (shared schedule groups + sessions) ─────
model Schedule {
  id                   String        @id @default(cuid())
  group                String        // "A" or "B"
  days                 String        // "Monday, Wednesday, Friday" or "Tuesday, Thursday, Saturday"
  session              String        // "Morning Session", "Afternoon Session", "Evening Session"
  startTime            String        // e.g. "08:00"
  endTime              String        // e.g. "10:00"
  startDate            DateTime?
  maxSeats             Int           @default(15)
  availabilityOverride Boolean?
  enrolled             Int           @default(0)
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  registrations        Registration[]

  @@unique([group, session])
  @@index([active])
}

// ── Course materials (downloadable learning resources) ─────
model CourseMaterial {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  fileType  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, sortOrder])
}

// ── Registrations (student applications) ──────────────
// One registration per student per course.
model Registration {
  id                 String        @id @default(cuid())
  referenceId        String        @unique // e.g. NA-2026-A1B2C3
  fullName           String
  email              String?
  phone              String
  age                Int
  courseId           String
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId         String?
  schedule           Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  previousExperience String        @default("")
  motivation         String        @default("")
  status             String        @default("PENDING") // PENDING, CONFIRMED; PAID is retained for legacy enrollments
  paidAt             DateTime?
  transactions       Transaction[]
  payments           Payment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([email, courseId])
  @@index([status])
  @@index([referenceId])
}

model Transaction {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String       @default("ETB")
  txRef          String       @unique
  chapaReference String?      @unique
  status         String       @default("PENDING")
  paymentMethod  String?
  serviceFee     Int?
  rawWebhook     Json?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([chapaReference])
  @@index([registrationId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  INCOMPLETE
  BLOCKED
  AUTH_NEEDED
  INVALID
}

model Payment {
  id                String        @id @default(cuid())
  registrationId    String
  registration      Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  merchantReference String        @unique
  chapaReference    String?       @unique
  amount            Int           // Chapa amount in minor currency units
  currency          String        @default("ETB")
  status            PaymentStatus @default(PENDING)
  checkoutUrl       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  verifiedAt        DateTime?

  @@index([registrationId, createdAt])
  @@index([status])
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  dedupKey       String   @unique
  event          String
  chapaReference String?
  createdAt      DateTime @default(now())
}

// ── Settings (key-value store) ────────────────────────
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}