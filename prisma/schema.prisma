// Nalik Academy - Prisma Schema
// Database: PostgreSQL (Neon)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Website Content (CMS key-value store, public read-only) ─
model Content {
  id        String   @id @default(cuid())
  section   String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
}

// ── Courses ───────────────────────────────────────────
model Course {
  id               String    @id @default(cuid())
  title            String
  description      String
  price            Int       @default(0)       // price in Birr
  discountPrice    Int?                         // discounted price in Birr
  discountLabel    String?                      // e.g. "Opening Offer, 19% off"
  discountStartAt  DateTime?                    // when the discounted price begins
  discountEndAt    DateTime?                    // when the discounted price ends
  active           Boolean   @default(true)     // shown in registration form
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active])
  applications Application[]
}

// ── Schedules (shared schedule groups + sessions) ─────
// Two fixed schedule groups (A and B) each with three sessions (Morning,
// Afternoon, Evening). Sessions are shared across all courses: a student
// books a seat in one session of one group for their chosen course.
model Schedule {
  id          String   @id @default(cuid())
  group       String   // "A" or "B"
  days        String   // "Monday, Wednesday, Friday" or "Tuesday, Thursday, Saturday"
  session     String   // "Morning Session", "Afternoon Session", "Evening Session"
  startTime   String   // e.g. "08:00"
  endTime     String   // e.g. "10:00"
  startDate   DateTime? // first day of class (shown on confirmation & lookup)
  maxSeats    Int      @default(15)
  // Admin availability marking: null = automatic (by seats), true = marked
  // Available, false = marked Full. Students can only select sessions that
  // are effectively available.
  availabilityOverride Boolean?
  enrolled    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([group, session])
  @@index([active])
  applications Application[]
}// ── Registrations (student applications) ──────────────
// Registration lifecycle: PENDING_PAYMENT → PAID → CONFIRMED
model Application {
  id                 String   @id @default(cuid())
  referenceId        String   @unique // e.g. NA-2026-0001
  fullName           String
  email              String
  phone              String
  age                Int
  courseId            String
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId          String?
  schedule            Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  previousExperience  String   @default("")
  motivation          String   @default("")
  status              String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, CONFIRMED
  paidAt              DateTime? // set when an admin marks the registration as paid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payment Payment?

  @@unique([email, courseId])
  @@index([status])
}

// ── Payments (Chapa v2 hosted checkout) ────────────────────
// One row per registration. The row is created as PENDING alongside the
// registration and is only ever moved to SUCCESS by a server-side
// verification or webhook — never by a browser callback.
//
// amount is minted server-side from the course price, so the value we expect
// is always available to re-check against what Chapa reports.
model Payment {
  id                String      @id @default(cuid())
  applicationId     String      @unique
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount            Int // amount in the payment currency, calculated server-side
  currency          String      @default("ETB")
  merchantReference String?     @unique // our unique reference per attempt
  chapaReference    String? // Chapa's own payment reference, from verify/webhook
  status            String      @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED, INCOMPLETE
  paymentMethod     String? // telebirr, cbebirr, card, …
  serviceFee        Int? // fee charged by Chapa
  paidAt            DateTime? // set when the payment reaches SUCCESS
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([chapaReference])
}

// ── Settings (key-value store) ────────────────────────
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
